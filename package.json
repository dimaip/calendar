{
    "name": "molitva.app",
    "version": "2.0.37",
    "description": "Orthodox calendar",
    "main": "index.js",
    "private": true,
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=20.19.0 <23",
        "yarn": "1.22.22"
    },
    "resolutions": {
        "@types/react": "18.3.31"
    },
    "scripts": {
        "start": "cross-env Z_URL=https://z.molitva.app PUBLIC_URL=http://localhost:3000 API_HOST=https://api.c.psmb.ru CONVEX_URL=https://dynamic-spider-481.eu-west-1.convex.cloud node server.js",
        "start-local": "cross-env Z_URL=http://z.molitva.app PUBLIC_URL=http://localhost:3000 API_HOST=http://localhost:9999 node server.js",
        "serve": "cross-env NODE_PORT=80 NODE_ENV=production node server.js",
        "redirect": "cross-env NODE_PORT=80 NODE_ENV=production node redirect.js",
        "build": "cross-env Z_URL=https://z.molitva.app PUBLIC_URL=https://molitva.app API_HOST=https://api.c.psmb.ru CONVEX_URL=https://convex.molitva.app NODE_ENV=production webpack --config webpack.prod.js",
        "build-aws": "cross-env Z_URL=https://z.molitva.app PUBLIC_URL=https://molitva.app API_HOST=https://api.c.psmb.ru CONVEX_URL=https://convex.molitva.app NODE_ENV=production webpack --config webpack.prod.js",
        "build-local": "cross-env Z_URL=http://localhost:8080 PUBLIC_URL=http://localhost API_HOST=https://api.c.psmb.ru NODE_ENV=production webpack --config webpack.prod.js",
        "build:e2e": "cross-env Z_URL=https://z.molitva.app PUBLIC_URL=http://127.0.0.1:4173 API_HOST=https://api.c.psmb.ru CONVEX_URL=https://convex.molitva.app NODE_ENV=production webpack --config webpack.prod.js",
        "twa-build": "cd TWA && bubblewrap update && bubblewrap build",
        "cap-build": "yarn build-aws && yarn cap sync",
        "cap-open": "yarn cap open ios",
        "lint": "yarn lint:eslint && yarn typecheck",
        "lint:eslint": "eslint app",
        "lint:ratchet": "node scripts/quality-ratchet.mjs lint",
        "lint:tsc": "yarn typecheck",
        "lint-fix": "eslint app --fix",
        "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx}\"",
        "format:write": "prettier --write \"app/**/*.{js,jsx,ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "typecheck:strict": "tsc --project tsconfig.strict.json",
        "typecheck:ratchet": "node scripts/quality-ratchet.mjs types",
        "quality": "yarn lint:ratchet && yarn typecheck:strict && yarn typecheck:ratchet",
        "quality:baseline": "node scripts/quality-ratchet.mjs update",
        "analyze:bundle": "node scripts/bundle-report.mjs",
        "test": "node scripts/run-tests.mjs",
        "test:auth": "tsx --test app/containers/auth/*.test.mjs app/utils/*.test.mjs",
        "test:e2e": "playwright test",
        "deploy": "git stash && git pull && yarn && yarn build &&s3cmd sync www/ s3://molitva.app/"
    },
    "author": "PSMB.ru",
    "license": "ISC",
